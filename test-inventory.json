{
  "version": 1,
  "repository": "TM-59/council-vote",
  "entrypoints": {
    "test": "make test",
    "check": "make check"
  },
  "kinds": {
    "unit": {
      "framework": "pytest",
      "requirements": [
        "REQ-HEALTH",
        "REQ-CORE",
        "REQ-CHECK",
        "REQ-VOTE",
        "REQ-AGENDA",
        "REQ-SEAT",
        "REQ-COUNCIL",
        "REQ-SESSION",
        "REQ-USECASE"
      ]
    },
    "integration": {
      "framework": "pytest",
      "marker": "integration",
      "requirements": [
        "REQ-PERSISTENCE",
        "REQ-ATOMIC"
      ]
    },
    "e2e": {
      "reason": "Deferred until the playable screen in M4."
    },
    "perf": {
      "reason": "Pure rules over eight agendas; no measurable performance contract before the screen in M4."
    },
    "mem": {
      "reason": "No simulation or persistence workload in M1."
    },
    "visual": {
      "reason": "No browser screen in M1."
    },
    "infra": {
      "reason": "No deployed infrastructure."
    },
    "trace": {
      "reason": "Session resolution history is stored in SQLite; no external event pipeline."
    }
  }
}
